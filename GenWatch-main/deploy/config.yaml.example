# GenWatch deployment configuration.
#
# Installed by the install.sh script to /etc/genwatch/config.yaml. To
# make changes safely:
#
#   sudo nano /etc/genwatch/config.yaml
#   sudo systemctl restart genwatch
#
# Most installations only need to:
#   1. transport + endpoint      ← modbus_tcp.host:port (Lantronix etc.) or serial.device
#   2. modbus.slave              ← 100 for stock H-100 (factory default)
#   3. auth.jwt_secret           ← auto-generated by installer (don't change)
#
# Operator logins are NOT configured here — each person gets their own
# account in the service database:
#
#   sudo -u genwatch genwatch useradd <username> --role admin
#
# Anything not set here falls back to package defaults. Putting this
# console on the internet? Read docs/SECURITY.md first.

# Set to true to disable real Modbus I/O and use the synthesized H-100
# state machine. Useful for previewing the UI before the bridge is
# wired or for offline UI development. Leave false in production: with
# a real transport configured, the service stays up even when the link
# is down (surfacing "Comms LOST" in the UI) and reconnects in the
# background — it never silently invents telemetry.
mock: false

# Which Modbus link to use:
#   tcp    — Modbus-RTU framed over a TCP socket. The expected setup is a
#            Lantronix UDS / EDS / xDirect (or Moxa NPort / Digi PortServer
#            / ser2net) that tunnels raw bytes between the network and a
#            physical RS-232/RS-485 port wired to the H-100. This is *not*
#            Modbus/TCP (port 502, MBAP header) — it's still RTU framing,
#            just travelling over TCP. Default Lantronix raw-TCP port is
#            10001. Configure on the bridge's web UI under
#            Channel 1 → Connection → Connect Mode = "Always" (passive).
#   serial — direct USB-to-serial cable plugged into this Pi. Use this if
#            the Pi is next to the generator and you don't want a network
#            bridge in the critical path.
transport: tcp

# Used when transport: tcp.
modbus_tcp:
  host: 192.168.1.249     # Lantronix LAN address
  port: 10001             # Lantronix Channel 1 default raw-TCP port
  timeout_s: 1.5          # per-request — bump if LAN latency is high
  connect_timeout_s: 3.0  # startup probe; affects how fast we fail boot
  framer: rtu             # H-100 frames RTU. Don't change unless your
                          # device actually exposes Modbus/TCP framing.

# Used when transport: serial. Left in place so you can flip transport
# back to 'serial' without losing cable settings.
serial:
  # /dev/genwatch-modbus is the stable symlink created by the bundled
  # udev rule (covers FTDI / CH340 / CP210x / PL2303 USB-to-serial chips
  # in both RS-232 cables and RS-485 modules). If your adapter isn't
  # recognized it will fall back to /dev/ttyUSB0; the installer prints
  # what it sees during setup.
  device: /dev/genwatch-modbus
  baud: 9600              # H-100 RS-232 default. RS-485 default is 4800.
  parity: N
  stopbits: 1             # H-100 RS-232 default. RS-485 default is 2.
  bytesize: 8
  timeout_s: 1.5

modbus:
  slave: 100              # 0x64 — H-100 factory default
  read_fc: 3              # 0x03 — read holding registers
  prime_poll_ms: 1500     # state + alarms cadence
  base_poll_ms: 15000     # full telemetry cadence
  retries: 2
  # Path is resolved against the package's bundled registers/ dir if
  # relative, else absolute. Edit registers/h100.yaml in place to adjust
  # per-site addresses; hot-reload via POST /api/registers/reload (admin).
  register_file: registers/h100.yaml

retention:
  raw_days: 7             # every-15s rows in `telemetry`
  rollup_1m_days: 90      # minute-bucketed averages
  rollup_1h_days: 730     # hour-bucketed averages (2 years)
  events_days: 30         # info/ok events; alarms+warns are kept forever
  audit_days: 0           # 0 = never delete audit log

# ─── Authentication ───────────────────────────────────────────────────────
# Operators sign in with their OWN username and password. Accounts live in
# the service database, not in this file:
#
#   sudo -u genwatch genwatch useradd alice --role admin
#   sudo -u genwatch genwatch userlist
#   sudo -u genwatch genwatch userpasswd alice
#
# Roles: viewer (read-only) · operator (+ start/stop/exercise/transfer,
# alarm ack) · admin (+ configuration, register map, user management).
#
# Before exposing this console to the internet, read docs/SECURITY.md and
# set security.public_exposure below — it turns that checklist into
# boot-time refusals instead of advice.
auth:
  # LEGACY single shared password. Used for exactly one thing: seeding the
  # first admin account on an upgrade, so an existing deployment isn't
  # locked out by it. Once any account exists this is never consulted
  # again — clear it, so a stale credential isn't sitting on disk.
  # Generate with: sudo -u genwatch genwatch hash
  admin_password_hash: "REPLACE_ME"
  # Username given to that seeded account.
  bootstrap_username: admin
  # JWT signing secret — installer auto-generates this; only change if
  # you want to invalidate all existing sessions.
  jwt_secret: "REPLACE_ME"
  operator_name: operator
  # Absolute session lifetime. Sessions are recorded server-side, so
  # signing out, changing a password, or an admin revoking sessions ends
  # them immediately rather than waiting for this to elapse.
  session_hours: 12
  # Also expire a session after this much operator inactivity. Someone
  # who leaves the console open on a shop laptop shouldn't hand over a
  # live session for the rest of the day. The live WebSocket does NOT
  # count as activity (an unattended Live view would otherwise keep the
  # session alive forever); the UI sends a keepalive on real user input.
  # 0 disables it — absolute expiry via session_hours still applies.
  idle_timeout_minutes: 60
  # Lifetime, in days, of a "keep me signed in on this device" session
  # (the checkbox on the login form). Remembered sessions skip the idle
  # timeout and silently renew while the device keeps using the console,
  # so a trusted device signs in once and stays signed in. Every
  # revocation path still applies: logout, password change, disabling
  # the account, and Settings → Users → sign-out-everywhere all end a
  # remembered session immediately, and each one is listed under
  # Settings → My Account. 0 disables the feature (the checkbox is then
  # ignored and every login gets a session_hours session). On an
  # internet-facing console pair this with require_totp — a long-lived
  # cookie on a stolen laptop is a live session for however long is set
  # here.
  remember_me_days: 365

  # ── Brute-force defence ────────────────────────────────────────────
  # Two independent layers. The per-IP bucket stops one host hammering
  # the endpoint; the per-account lockout follows the *target* instead,
  # which is what a botnet rotating source addresses cannot sidestep.
  lockout_threshold: 5        # failed sign-ins before the account locks
  lockout_seconds: 900        # first lockout; doubles on each further one
  lockout_max_seconds: 3600   # cap. 0 in lockout_seconds disables lockout
  login_rate_burst: 5         # per-IP attempts before throttling
  login_rate_refill_seconds: 180

  # Minimum length for NEW passwords. The policy also rejects common
  # passwords, keyboard runs, and passwords containing the username.
  # Passwords already on disk are never re-validated.
  password_min_length: 12

  # ── Two-factor authentication ──────────────────────────────────────
  # Strongly recommended for an internet-facing console: it is the one
  # control that still holds when a password is reused, phished or
  # leaked. Enroll every account FIRST (Settings → My Account, or
  # `genwatch usertotp <name>`), THEN set this to true — accounts that
  # haven't enrolled are refused, not silently exempted.
  require_totp: false
  totp_issuer: "Castle Generator Monitor"

  # ── Session-cookie hardening ───────────────────────────────────────
  # Leave both at their defaults unless you have a specific reason. The
  # defaults are safe for the three documented deployment topologies
  # (plain LAN, Caddy, Tailscale).
  #
  # cookie_secure:
  #   unset (null) → auto-detect from the request. HTTPS in front (Caddy
  #                  /Tailscale terminating TLS on the same host) gives
  #                  Secure for free; plain-HTTP LAN stays non-Secure.
  #                  Over HTTPS the cookie also gets the `__Host-` name
  #                  prefix, which stops a sibling hostname planting a
  #                  session cookie on us.
  #   true          → force Secure on every response. Use behind an HTTPS
  #                  reverse proxy that doesn't forward X-Forwarded-Proto.
  #   false         → never Secure. Only for local dev.
  # cookie_secure: null
  #
  # cookie_samesite — strict | lax | none.
  #   'strict' (default) blocks the session cookie from being sent on
  #   cross-site navigations, defense-in-depth against CSRF on top of the
  #   two-step confirm tokens. UX cost: clicking a link from Slack/email
  #   into the console shows the login page once.
  # cookie_samesite: strict

# ─── Network / HTTP hardening ─────────────────────────────────────────────
# See docs/SECURITY.md for the full internet-exposure checklist.
security:
  # Declare this console reachable from the open internet. The service
  # then REFUSES to start on a configuration that is fine on a LAN and
  # reckless in public (mock mode, cookie_secure: false, cors '*',
  # lockout disabled, no admin account) and warns about the rest.
  # It also turns require_https on by default.
  public_exposure: false

  # Refuse plain-HTTP requests (GET redirects to https, writes are
  # rejected so a password is never re-sent in the clear). Unset = follow
  # public_exposure. The scheme is read from the request, including
  # X-Forwarded-Proto from a trusted proxy — see GENWATCH_TRUSTED_PROXIES
  # in the systemd unit.
  # require_https: null

  # Response hardening headers: CSP, frame-ancestors none, nosniff,
  # no-referrer, Permissions-Policy, no-store on API responses, and HSTS
  # on requests we already saw as HTTPS (so it can never brick a
  # plain-HTTP LAN deployment).
  headers_enabled: true
  hsts_enabled: true
  hsts_max_age: 31536000
  # Only enable if EVERY hostname under this domain is HTTPS — browsers
  # remember this for a year.
  hsts_include_subdomains: false

  # Content-Security-Policy. The default is in genwatch/config.py; the
  # `{ws_self}` placeholder is substituted per-request with this host's
  # ws:// and wss:// origins so the Live view's WebSocket works without
  # opening connect-src to the whole internet. Set to "" to disable.
  # csp: "..."

  # Optional network allowlist — IPs or CIDRs. Empty = allow all.
  # Loopback ALWAYS passes so a typo here can't cost you a site visit.
  # Behind a reverse proxy this only works if the proxy sets
  # X-Forwarded-For and is listed in GENWATCH_TRUSTED_PROXIES; otherwise
  # every request looks like it came from the proxy.
  ip_allowlist: []
  #  - 203.0.113.4
  #  - 198.51.100.0/24
# ─── Slack alerts ─────────────────────────────────────────────────────────
# Forwards alarms, alarm-clears, operator commands, and (optionally)
# state/comms transitions to a Slack channel.
#
# Setup:
#   1. Create a Slack app:  https://api.slack.com/apps  →  "From scratch"
#   2. OAuth & Permissions  →  Bot Token Scopes  →  add  chat:write
#   3. Install to workspace  →  copy the "Bot User OAuth Token" (xoxb-...)
#   4. Invite the bot to your alert channel:  /invite @YourBotName
#   5. Paste the token below, set enabled: true, set channel, restart.
#
# Slack settings can also be edited through the Settings → Alerts page
# in the UI (admin role); the UI hot-reloads without a service restart.
slack:
  enabled: false
  bot_token: ""           # xoxb-... — keep secret! file mode is 0640.
  channel: ""             # "#genwatch-alerts" or channel id "C0123ABCD"
  site_label: ""          # overrides site.name in Slack messages, optional
  alert_on_alarm: true            # alarm-severity events (engine shutdowns, etc.)
  alert_on_warning: true          # warn-severity events (low battery, etc.)
  alert_on_alarm_cleared: true    # operator-ack and auto-clears
  alert_on_state_change: false    # every stopped/cranking/running/cooling — chatty
  alert_on_command: true          # operator-issued start/stop/exercise/transfer
  alert_on_comms_lost: true       # Modbus link lost / recovered

  # ── Transfer alerts · utility ↔ generator ──────────────────────────
  # The alert people actually wait for: the load just moved to the
  # generator, or the utility is back. Driven by the ATS-Pi's physical
  # switch position when that companion is healthy and by the H-100's
  # electrical readings otherwise — it works either way.
  alert_on_load_source_change: true      # master switch for the three below
  alert_on_transfer_to_generator: true   # utility → generator (the outage page)
  alert_on_return_to_utility: true       # generator → utility (the all-clear)
  # Both the ATS position and the electrical inference went dark. Usually
  # an instrumentation problem rather than a transfer, so it's off by
  # default and can't drown the two alerts above.
  alert_on_load_source_unknown: false

  # Send transfer alerts to their own channel — e.g. an on-call channel
  # that pages, while routine alarms stay in a quieter one. Blank = use
  # `channel` above. (Invite the bot to any channel you name here.)
  channel_load_source: ""

  # Text prepended to the transfer message so Slack actually notifies
  # someone. Slack mention syntax, NOT a plain @name:
  #   "<!channel>"            everyone in the channel
  #   "<!here>"               everyone currently online
  #   "<@U024BE7LH>"          one person, by member ID
  #   "<!subteam^S012ABC3DE>" a user group
  # Blank = no mention (the message still posts).
  mention_on_transfer_to_generator: ""
  mention_on_return_to_utility: ""

  # Hold a transfer alert this many seconds and only send it if the load
  # source is still there when the timer fires. An ATS that hunts, or a
  # utility browning out repeatedly, otherwise produces a burst of
  # contradictory pages during the exact minutes you need a clear signal.
  # A flap that lands back where it started sends nothing at all.
  # 0 = send immediately.
  load_source_debounce_s: 0

  # ── Fuel alerts ────────────────────────────────────────────────────
  # Gated by the `fuel` section below (off by default). These flags only
  # pick which fuel events reach Slack once monitoring is on.
  alert_on_fuel_warning: true     # crossed the low threshold
  alert_on_fuel_critical: true    # crossed the critical threshold
  alert_on_fuel_reminder: true    # still low N hours later
  alert_on_fuel_recovered: true   # refuelled
  alert_on_fuel_drop: true        # abnormal drop (possible leak / theft)
  channel_fuel: ""                # blank = use `channel`
  # Applied to the critical tier and the drop alert only — a "order fuel
  # this week" warning that pings @channel at 2 a.m. teaches people to
  # mute the channel. Same syntax as the transfer mentions above.
  mention_on_fuel_critical: ""

  # ── Sign-in & account alerts ───────────────────────────────────────
  # Worth turning on whenever this console is internet-facing — it's how
  # you learn about a password-spraying attempt from Slack rather than
  # from the audit table afterwards. Failures are deduplicated per
  # account per minute so an attack can't flood the channel.
  alert_on_login_failure: true    # wrong password, bad 2FA code, unknown account
  alert_on_account_lockout: true  # an account locked out — the one that matters
  alert_on_login_success: false   # every sign-in, with source IP — chatty
  alert_on_user_change: true      # account created/deleted/role/password/2FA
  # These messages name accounts and source addresses; an admin-only
  # channel is usually the right home. Blank = use `channel`.
  channel_security: ""

# ─── Fuel level monitoring ────────────────────────────────────────────────
# Low-tank warnings and abnormal-drop (leak / theft) detection. Alerts are
# sent through Slack using the alert_on_fuel_* flags above; the thresholds
# here describe the CONDITION rather than the notification.
#
# Evaluated whether or not the engine is running — unlike the register
# warn_range/alarm_range bands, which only apply while it is producing. A
# tank running dry matters most while the generator is stopped and there
# is still time to do something about it.
#
# DISABLED BY DEFAULT on purpose: fuel_level_pct (0x0092) is not verified
# on every H-100 revision, and an unconfigured channel on this controller
# reads 0xFFFF. Confirm the reading against the panel first:
#
#     sudo -u genwatch genwatch panel | grep fuel
#
# Automatically inert at gaseous-fuel sites (site.fuel_type in the
# register map) — no local tank to run out of. Tank size for the "≈N gal"
# figure in the alerts also comes from the register map (site.tank_gal).
fuel:
  enabled: false
  warn_pct: 25            # "order fuel this week"
  critical_pct: 10        # "you have hours of runtime left"
  # A tank on a running genset sloshes. The level must rise this far above
  # a threshold before we call the situation improved, so a sender
  # hovering on the line warns once instead of flapping.
  hysteresis_pct: 3
  # Repeat while the tank is still low — silence after the first message
  # reads as "handled". 0 = say it once.
  renotify_hours: 12
  # Readings outside this band are treated as a SENSOR FAULT and suppress
  # alerting, rather than being read as an empty tank.
  min_valid_pct: 0
  max_valid_pct: 100
  # Abnormal-drop detection: alert when the level falls this many points
  # within drop_window_minutes. 0 = off. The right threshold depends on
  # tank size and site behaviour, so there is no useful default.
  drop_alert_pct: 0
  drop_window_minutes: 60
  # Only evaluate while the engine is NOT burning fuel. A loaded generator
  # drawing the tank down is expected and would alert on every outage; the
  # same fall with the engine stopped is a leak or a siphon.
  drop_only_when_stopped: true

# ─── MQTT status publishing ───────────────────────────────────────────────
# When enabled, GenWatch publishes the generator's load status to an MQTT
# broker on every utility ↔ generator transition:
#
#   load transfers to the generator → publish "ON"  to  facility/generator/status
#   load returns to utility          → publish "OFF" to  facility/generator/status
#
# The message is published *retained*, so a home-automation / SCADA / dashboard
# subscriber that connects later immediately learns the current state. The
# signal is the same utility↔generator load source shown in the UI and Slack:
# driven by the ATS-Pi's physical position when that companion is present and
# healthy, and by the H-100 electrical inference otherwise (works either way).
#
# No extra software is needed on this host — GenWatch speaks MQTT directly.
# Point it at any broker (Mosquitto, EMQX, HiveMQ, Home Assistant's add-on…).
# MQTT settings can also be edited from Settings → Alerts in the UI (admin);
# they hot-reload without a service restart.
mqtt:
  enabled: false
  host: 127.0.0.1         # broker hostname or IP
  port: 1883              # 1883 plain, 8883 for TLS
  topic: facility/generator/status
  payload_on: "ON"        # published when the generator takes the load
  payload_off: "OFF"      # published when the load returns to utility
  qos: 1                  # 0 = at most once, 1 = at least once (broker PUBACK)
  retain: true            # keep last status on the broker for late subscribers
  username: ""            # blank = anonymous connect
  password: ""            # keep secret! config file mode is 0640
  client_id: ""           # blank = a stable id derived from the site name
  tls: false              # true to connect over TLS (typically port 8883)
  tls_insecure: false     # skip cert verification (self-signed broker on a trusted LAN only)
  publish_on_start: false # also seed the retained topic with current state at boot

# WebSocket push cadence (ms). Leave at prime_poll_ms unless the UI
# feels sluggish.
ws_push_ms: 1500

# ─── ATS-Pi companion device (optional) ──────────────────────────────────
# When `enabled: true`, GenWatch polls a second Modbus TCP device on the
# LAN — the "ATS-Pi" — that physically observes the ASCO Series 300
# transfer switch. Its `position` register becomes the authoritative
# loadSource for the UI (more accurate than the H-100-derived value).
# When disabled or unreachable, GenWatch silently falls back to the
# H-100-electrical loadSource derivation; no operator-visible change
# other than a "(via gen telemetry)" provenance subscript in the UI.
#
# See:
#   docs/integrations/ats-pi-icd.md      — wire contract
#   docs/integrations/ats-pi-plan.md     — phased integration plan
ats:
  enabled: false
  host: 192.168.1.250
  # Companion starter defaults to 5020 (high port, no root needed on
  # the companion). If you've explicitly configured the companion for
  # 502 (the Modbus TCP convention), switch this to 502 to match.
  port: 5020
  framer: socket            # Modbus/TCP (MBAP). 'rtu' only for RTU-over-TCP.
  slave: 1
  register_file: registers/ats_pi.yaml
  # Optional sanity check — when set, GenWatch refuses to treat the
  # ATS-Pi as authoritative unless its reported ats_pi_unit_id matches.
  # Prevents wrong-site comms in a future multi-site deployment.
  expected_unit_id: 23
